            "mimeType": "application/javascript",
            "compression": 0,
            "text": "const data = document.querySelector(\"#data\");\r\nconst btn = document.querySelector(\".btn\");\r\nconst URL = \"https://abhi-api.vercel.app/api/anime/loli\";\r\n\r\n// let promise = fetch(URL);\r\n// console.log(promise);\r\n// const getpromise = async ()=>{\r\n// // console.log(\"Getting data.....\");\r\n// let promise = await fetch(URL);\r\n// // console.log(promise.status);\r\n// const data1 = await promise.json();\r\n// // console.log(data1.log);\r\n// // console.log(data1);\r\n// data.innerHTML =(data1.status);\r\n// }\r\n// console.log(data1); // it will not work as you want\r\n// data.innerHTML =(data1.log);\r\n\r\n\r\n// 3 - Another method of to get the same API\r\n// const getresponse = () =>{\r\n//   fetch(URL).then((res)=>{\r\n//     return res.json();\r\n//   }).then((response)=>{\r\n//     console.log(response);\r\n//     data.innerHTML =(response.creator);\r\n//   })\r\n// }\r\n\r\n//  2 - Another method \r\n// function tem(){\r\n//   fetch(URL).then(y=>y.json()).then(x=> data.innerHTML = x.status);    // single line representation (for  multiline use to curly braces)\r\n// }\r\n\r\n// btn.addEventListener(\"click\",getresponse);\r\n\r\n// const getresponse = async() =>{\r\n// const response = await fetch(URL);\r\n// console.log(response);\r\n// console.log(response.type);\r\n// const promise = await response.json();\r\n// console.log(promise);\r\n// console.log(promise.creator);\r\n// }\r\n// btn.addEventListener(\"click\",getresponse);\r\n  \r\n// 3-Another method\r\nconst getresponse =  async() =>{\r\n  try{\r\n    const x =  await fetch(URL);\r\n    console.log(x);\r\n    let data = await x.json();\r\n    console.log(data);\r\n    console.log(x.status);\r\n  }catch(err){\r\n    console.log(\"You are going in wrong direction please correct it:-\",err);\r\n  }\r\n}\r\n \r\n\r\nbtn.addEventListener(\"click\",getresponse);\r\n\r\n\r\n\r\n"
